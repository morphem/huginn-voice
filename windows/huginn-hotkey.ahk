#Requires AutoHotkey v2.0
#SingleInstance Force
; Huginn dictation anywhere in Windows: hold Right Ctrl, speak, let go — the text is typed where the
; cursor is (Teams, mail, any field). It never presses Enter: you read it, then send it yourself.
; Generated by scripts/install-hotkey.sh; the line below points at bin/huginn-hotkey.py in WSL.
WRAPPER := "{{WRAPPER}}"

dir := A_Temp "\huginn-hotkey"
DirCreate dir
wdir := "/mnt/" StrLower(SubStr(dir, 1, 1)) StrReplace(SubStr(dir, 3), "\", "/")
A_IconTip := "Huginn: hold Right Ctrl and speak"

RCtrl:: {
    for name in ["out.txt", "err.txt", "stop", "mic"]
        try FileDelete dir "\" name
    Run 'wsl.exe -e python3 "' WRAPPER '" --dir "' wdir '"', , "Hide", &pid
    ToolTip "… Huginn"
    while GetKeyState("RCtrl", "P") {
        if FileExist(dir "\mic")
            ToolTip "🎙 Huginn listening… (let go to type)"
        Sleep 50
    }
    FileAppend "", dir "\stop"
    ToolTip "⏳ Huginn…"
    ProcessWaitClose pid, 30
    ToolTip
    text := ""
    try text := FileRead(dir "\out.txt", "UTF-8")
    text := Trim(StrReplace(StrReplace(text, "`r", " "), "`n", " "), " `t")
    if (text != "") {
        SendText text
        return
    }
    why := "nothing was heard"
    try why := FileRead(dir "\err.txt", "UTF-8")
    ToolTip "Huginn: " why
    SetTimer () => ToolTip(), -4000
}
