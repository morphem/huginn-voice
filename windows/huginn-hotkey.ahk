#Requires AutoHotkey v2.0
#SingleInstance Force
; Huginn dictation anywhere in Windows: hold Right Ctrl, speak, let go — the text is typed where the
; cursor is (Teams, mail, any field), followed by a space. It never presses Enter: you send it.
; Press Right Shift too (any moment while holding) and the Polish you say is typed in English.
; Generated by scripts/install-hotkey.sh; the line below points at bin/huginn-hotkey.py in WSL.
WRAPPER := "{{WRAPPER}}"

; One folder per running script, so a reload never shares files with the previous instance's helper.
dir := A_Temp "\huginn-hotkey\" ProcessExist()
DirCreate dir
wdir := "/mnt/" StrLower(SubStr(dir, 1, 1)) StrReplace(SubStr(dir, 3), "\", "/")
helper := 0
A_IconTip := "Huginn: hold Right Ctrl and speak (+ Right Shift: English)"

; The helper waits in WSL with the microphone closed, so a key press costs only opening the mic.
StartHelper() {
    global helper
    try FileDelete dir "\quit"
    try FileDelete dir "\alive"
    FileAppend "", dir "\alive"
    Run 'wsl.exe -e python3 "' WRAPPER '" --serve --dir "' wdir '"', , "Hide", &helper
}
Alive() {
    try FileSetTime , dir "\alive"
}
StartHelper()
SetTimer Alive, 60000
OnExit (*) => FileAppend("", dir "\quit")

*RCtrl:: {
    for name in ["out.txt", "err.txt", "src.txt", "stop", "mic", "done"]
        try FileDelete dir "\" name
    if !ProcessExist(helper)
        StartHelper()
    FileAppend "", dir "\go"
    english := false
    ToolTip "⏳ wait…"
    while GetKeyState("RCtrl", "P") {
        english := english || GetKeyState("RShift", "P")
        if FileExist(dir "\mic")
            ToolTip english ? "🎙 speak Polish → 🇬🇧 English — let go to type" : "🎙 speak — let go to type"
        Sleep 30
    }
    FileAppend english ? "en" : "", dir "\stop"
    ToolTip "⏳ Huginn…"
    t0 := A_TickCount
    while !FileExist(dir "\done") && A_TickCount - t0 < 30000
        Sleep 30
    ToolTip
    text := ""
    try text := FileRead(dir "\out.txt", "UTF-8")
    text := Trim(StrReplace(StrReplace(text, "`r", " "), "`n", " "), " `t")
    if (text != "") {
        SendText text " "
        if english {                    ; what was heard in Polish, to check the pronunciation
            heard := ""
            try heard := FileRead(dir "\src.txt", "UTF-8")
            if (heard != "") {
                ToolTip "🇵🇱 " heard
                SetTimer () => ToolTip(), -6000
            }
        }
        return
    }
    why := "nothing was heard"
    try why := FileRead(dir "\err.txt", "UTF-8")
    ToolTip "Huginn: " why
    SetTimer () => ToolTip(), -4000
}
